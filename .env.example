# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (SQLite by default)
DATABASE_URI=sqlite:///restaurant.db

# Google Gemini API Configuration (Sole LLM Provider)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Verified Gemini generation models: gemini-2.5-flash (recommended default), gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# Official Gemini embedding model for RAG: gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector Database (ChromaDB local persistence)
CHROMA_PERSIST_DIR=./data/chroma_db

# Agent defaults for future LangGraph/LLM usage
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=512
