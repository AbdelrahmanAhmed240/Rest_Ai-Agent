# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (SQLite by default)
DATABASE_URI=sqlite:///restaurant.db

# OpenRouter Configuration (FREE models only — must end in :free)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,z-ai/glm-5.2:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Vector Database (ChromaDB local persistence)
CHROMA_PERSIST_DIR=./data/chroma_db

# Agent defaults for future LangGraph/LLM usage
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=512
